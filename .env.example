# ==========================================
# SpendSense Environment Configuration Example
# ==========================================

# Choose LLM connection: mock (zero-cost offline mode), openai, context_dev, or openai_compatible
LLM_PROVIDER=mock

# OpenAI API config (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Context.dev configuration (required if LLM_PROVIDER=context_dev)
CONTEXT_DEV_API_KEY=your_context_dev_key_here
CONTEXT_DEV_MODEL=gpt-4o-mini

# Local Whisper Speech configuration (set to true to run Whisper locally, false to use API/Mock)
WHISPER_LOCAL=false
